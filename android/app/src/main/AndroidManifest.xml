<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- Android Automotive(AAOS) 전용 앱 -->
	<uses-feature android:name="android.hardware.type.automotive" android:required="true" />
	<uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
	<uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

	<!-- ── Vehicle SDK 읽기 권한: 미션 감지에 쓰는 도메인만 (2.3.2 AAR의 @RequiresPermission 기준) ──
	     CAR_CLIMATE: 공조(제상·오토·에어컨·내기순환·공기청정·풍량·온도), 핸들 열선
	     CAR_SEATS:   시트 열선·통풍
	     CAR_LIGHTS:  무드등 색, 독서등, 실내등, 상향등, 방향지시등
	     CAR_DRIVE:   기어, 크루즈 목표 속도, 누적 주행거리
	     CAR_WINDOWS: 와이퍼
	     차량 제어(CONTROL_CAR_*)는 쓰지 않는다. 앱은 차를 바꾸지 않고, 바뀐 것을 알아채기만 한다. -->
	<uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
	<uses-permission android:name="pleos.car.permission.CAR_SEATS" />
	<uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
	<uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
	<uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
	<!-- 음성 안내 -->
	<uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

	<application
		android:allowBackup="false"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/Theme.App">

		<!-- android.car 공유 라이브러리 (CarUxRestrictionsManager) -->
		<uses-library android:name="android.car" android:required="false" />

		<!-- CCP(로터리 컨트롤러) 미지원 선언: 모든 조작은 터치로 -->
		<meta-data android:name="com.hmg.rotary.ROTARY_SUPPORTED" android:value="false" />

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:resizeableActivity="true"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
			android:launchMode="singleTask">
			<!-- 주행 중에도 떠 있되, 주행 화면은 글자 한두 줄짜리 정지 화면만 보여 준다(DrivingScreen).
			     버튼·목록·소리는 정차 중에만. (docs/05_개발/결정기록.md D16) -->
			<meta-data android:name="distractionOptimized" android:value="true" />
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>
	</application>
</manifest>
